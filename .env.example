# Optional for the public sample pages. Required for /giris and /admin.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public application origin used in invitation redirects and, later, canonical
# URLs. Keep it in the Supabase Auth site URL/redirect allowlist.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Required for admin invitations. Never expose this key in the
# browser or in a NEXT_PUBLIC_* variable.
SUPABASE_SECRET_KEY=
