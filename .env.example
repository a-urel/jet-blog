# Optional for the public sample pages. Required for /login and /admin.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public application origin used in invitation redirects, canonical URLs,
# Open Graph, JSON-LD, share links, sitemap.xml, and robots.txt. Keep it in the
# Supabase Auth site URL/redirect allowlist. Without it, the site is noindex
# and robots.txt disallows crawling. Provisional until the domain is decided.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional publication name for titles and Open Graph (provisional default:
# "Yazılar"). The brand is not decided yet.
NEXT_PUBLIC_SITE_NAME=

# Server-only. Required for admin invitations. Never expose this key in the
# browser or in a NEXT_PUBLIC_* variable.
SUPABASE_SECRET_KEY=
